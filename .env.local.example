# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used only by the seed script (supabase/seed/seed.ts) — never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Enables Google Maps / Google Satellite basemaps when set.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Optional locally, recommended in production. Enables the Mapbox basemaps and becomes the
# default basemap when set — OpenStreetMap's raw tile server (the fallback default) is not
# meant for production/bulk traffic. Get a token at https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional. Sentry DSN for error monitoring (client + server). Leave unset to disable —
# the SDK becomes a no-op with no DSN, so this is safe to leave blank locally.
NEXT_PUBLIC_SENTRY_DSN=

# Optional, build-time only. Needed to upload source maps to Sentry (readable stack traces
# in production errors) — without these the build still succeeds, it just skips the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
