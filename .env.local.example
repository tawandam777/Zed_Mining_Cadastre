# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used only by the seed script (supabase/seed/seed.ts) — never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Enables Google Maps / Google Satellite basemaps when set.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
